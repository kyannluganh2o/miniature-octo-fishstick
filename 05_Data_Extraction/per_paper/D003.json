  "key_results": [
    "Increasing cloud loading attenuates shock strength and induced velocity. Smaller droplets extract more momentum and respond within the short shocked-state interval.",
    "Reference model: ambient 2 MPa, 293 K, pressure amplitude ratio 1.085, cloud density 6 kg/m³. For 50 μm droplets, shocked-state ~60 μs versus Stokes response ~750 μs."
  ],
  "mechanisms": [
    {
      "summary": "Model-based: push-away arises from momentum transfer during a short, expansion-terminated shocked region; inertia limits large-droplet response.",
      "support_type": "author_interpretation_or_model_based"
    }
  ],
  "evidence_candidates": [
    {
      "claim_id": "PILOT-D003-C01",
      "claim": "A jet-induced shock can create a push-away impulse, but the effective shocked-state duration is shortened by a following expansion wave.",
      "evidence_type": "model_based",
      "source_location": "PDF p.10, Conclusions",
      "support_type": "indirect"
    },
    {
      "claim_id": "PILOT-D003-C02",
      "claim": "Droplet response depends strongly on particle size relative to the short forcing interval.",
      "evidence_type": "simulation_resolved",
      "source_location": "PDF p.9, Figs. 12–13 and discussion",
      "support_type": "direct"
    }
  ],
