  "key_results": [
    "Cycle-composite efficiency benefit was of order 3% and PM reduction 40–60%; peak-torque alternatives were reported as 7% efficiency, 20% power, or 90% PM benefit.",
    "Benefits were concentrated above roughly 75% load."
  ],
  "mechanisms": [
    "Higher pressure raises gas mass injection rate and improves late-cycle mixing/oxidation; it also raises heat-release intensity."
  ],
