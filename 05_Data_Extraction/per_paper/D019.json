  "key_results": [
    "Detonation heat release increases reflected-shock propagation at equal leading Mach.",
    "Detonation cavitation collapses sooner and asymmetrically.",
    "Detonation suppresses shock-case RT forward jetting and favors leeward flattening."
  ],
  "mechanisms": [
    {
      "summary": "Reaction heat release changes postwave pressure, velocity and sound speed, which alter wave propagation, cavitation duration and deformation mode.",
