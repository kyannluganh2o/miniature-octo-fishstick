    }
  ],
  "evidence_candidates": [
    {
      "claim_id": "T1-D019-C01",
      "claim": "At equal leading-shock Mach, detonation and inert-shock cases have similar early wave topology but detonation heat release increases reflected-shock propagation through different postwave velocity and sound-speed states.",
      "evidence_type": "primary_numerical",
      "evidence_summary": "Matched Mach 4.8 comparison and moving-shock analysis isolate reaction-heat-release effects.",
      "locator": "wave",
      "support_type": "model_based",
      "limitations": "2D idealized water droplet and reduced reaction model; project transfer beyond this configuration remains inference.",
      "parameters": [
